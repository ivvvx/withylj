---
import type { CollectionEntry } from 'astro:content';
import { responsiveCover } from '../utils/image';

const base = import.meta.env.BASE_URL;

interface Props {
  post: CollectionEntry<'posts'>;
  album?: boolean;
}

const { post, album = false } = Astro.props;
const { title, date, cover, tags, summary } = post.data;
const coverUrl = cover ? (cover.startsWith('/') ? `${base}/${cover.slice(1)}` : cover) : `${base}/images/placeholder.jpg`;
const responsive = responsiveCover(coverUrl);
---

<article class={`bg-warm-bg-pink rounded-2xl overflow-hidden border border-warm-border hover:shadow-md transition-shadow ${album ? 'break-inside-avoid mb-3' : ''}`}>
  <a href={`${base}/posts/${post.id}/`}>
    <div class={`bg-warm-pink-light/30 overflow-hidden ${album ? '' : 'aspect-[4/3]'}`}>
      <img
        src={responsive.src}
        srcset={responsive.srcset}
        sizes={responsive.sizes}
        alt={title}
        class={`w-full object-cover ${album ? 'h-auto' : 'h-full'}`}
        loading="lazy"
        decoding="async"
        width="400"
        height="300"
      />
    </div>
    <div class="p-3">
      <h3 class="text-sm font-bold text-gray-700 leading-snug">{title}</h3>
      <p class="text-xs text-warm-gray mt-1">
        {new Date(date).toLocaleDateString('zh-CN')}
      </p>
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1 mt-2">
          {tags.map((tag: string) => (
            <span class="bg-warm-pink-light/50 text-warm-pink text-[10px] px-2 py-0.5 rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>
